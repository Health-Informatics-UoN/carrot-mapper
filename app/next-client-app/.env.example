# Local development environment for the frontend (run from source, see
# CONTRIBUTING.md). Copy this file to `.env` in this directory.
#
# Points at an API running from source on localhost:8000 (see the root
# .env.example) rather than the `api` container hostname used in prod.

BACKEND_URL=http://localhost:8000
BACKEND_ORIGIN="localhost:8000"
NEXTAUTH_URL=http://localhost:3000/
# next-auth v4's NextAuth() reads AUTH_SECRET (via options.ts); its
# middleware reads NEXTAUTH_SECRET. Keep both set to the same value.
NEXTAUTH_SECRET=verycomplexsecretkey
AUTH_SECRET=verycomplexsecretkey
NEXTAUTH_BACKEND_URL=http://localhost:8000/api/
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

NODE_ENV=development
NEXT_PUBLIC_ENABLE_REUSE_TRIGGER_OPTION=true
NEXT_PUBLIC_ENABLE_AI_RECOMMENDATION=true
NEXT_PUBLIC_RECOMMENDATION_SERVICE=unison
RECOMMENDATION_SERVICE_BASE_URL=https://api.hyperunison.com/api/public/suggester/generate
RECOMMENDATION_SERVICE_API_KEY=unison-api-key
NEXT_PUBLIC_BODY_SIZE_LIMIT=31457280

# Local development environment for the API (run from source, see CONTRIBUTING.md).
#
# `docker compose up` runs the supporting services only (db, minio/azurite,
# omop-lite, airflow); the API and frontend are run from source against them.
#
# Copy this file to `.env` at the repo root: python-dotenv (used by
# app/api/config/settings.py) walks up from app/api looking for a `.env`,
# so a single root-level file covers the API when run from source.

# Profiles to bring up by default with `docker compose up` (activates the
# `minio` service, matching STORAGE_TYPE below). Use `azure` instead if you
# want to develop against azurite.
COMPOSE_PROFILES=main

FRONTEND_URL=http://localhost:3000
ALLOWED_HOSTS=['localhost', '127.0.0.1']
AZURE_ACCOUNT_NAME=devstoreaccount1

DB_ENGINE=django.db.backends.postgresql
DB_HOST=localhost
DB_NAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DB_USER=postgres

DEBUG=True

# Prod defaults to 20s; migrations against a fresh local DB can run long
# (e.g. on Docker Desktop's slower disk), so give dev more headroom.
DB_STATEMENT_TIMEOUT=120s

RULES_QUEUE_NAME=rules-queue
WORKERS_RULES_NAME=RulesOrchestrator
WORKERS_UPLOAD_NAME=upload-reports-queue
WORKERS_RULES_EXPORT_NAME=rules-exports-queue

# To match with the capacity of the production environment
DATA_UPLOAD_MAX_MEMORY_SIZE=31457280

# Default superuser credentials for dev environment (see
# mapping/management/commands/default_super_user.py)
SUPERUSER_DEFAULT_USERNAME=admin
SUPERUSER_DEFAULT_PASSWORD=admin
SUPERUSER_DEFAULT_EMAIL=admin@carrot.com

STORAGE_TYPE=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
WORKER_SERVICE_TYPE=airflow

AIRFLOW_BASE_URL=http://localhost:8080/api/v1/
AIRFLOW_AUTO_MAPPING_DAG_ID=auto_mapping
AIRFLOW_SCAN_REPORT_PROCESSING_DAG_ID=scan_report_processing
AIRFLOW_RULES_EXPORT_DAG_ID=rules_export
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin

SECRET_KEY=secret
STORAGE_CONN_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;QueueEndpoint=http://localhost:10001/devstoreaccount1;"

SIGNING_KEY=secret
NEXTJS_URL=http://localhost:3000
ENABLE_PROXY=true
AZ_FUNCTION_URL=http://localhost:7071
